{
	"name": "rhino",
	"version": "0.2.5",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "CLOUDFLARE_ENV=local vite --host 127.0.0.1",
		"login:prod": "cloudflared access login https://rhino.hexly.ai > /dev/null",
		"build": "vite build",
		"typegen": "wrangler types --include-runtime=false --strict-vars=false",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "bun scripts/unit-tests.ts",
		"test:l2": "node scripts/run-tests.ts l2",
		"test:l3": "node scripts/run-tests.ts l3",
		"gate:l1": "bun scripts/gate-l1.ts",
		"gate:security": "bun scripts/security.ts",
		"gate:pre-push": "bun scripts/gate-pre-push.ts",
		"db:migrate": "wrangler d1 migrations apply rhino-local --local --env local",
		"prepare": "husky",
		"gate:verify": "bun scripts/verify-gates.ts"
	},
	"dependencies": {
		"@nocoo/basalt": "3.2.1",
		"jose": "6.2.12",
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"recharts": "3.10.1",
		"three": "0.186.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vite-plugin": "1.64.0",
		"@cloudflare/workers-types": "5.20261024.1",
		"@playwright/test": "1.64.1",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.186.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"wrangler": "4.152.0"
	},
	"overrides": {
		"sharp": "0.35.5",
		"miniflare>undici": "7.29.1"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"workerd"
	]
}
